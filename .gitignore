# --- existing rules ---
# Ignore any untracked folder at the repo root (keeps new runs_*/output_* dirs out).
# Leading slash anchors the rule to the root so it does NOT recursively re-ignore
# subfolders inside tracked directories like further_experiments/ or recap_2026/.
/*/
.env
.env.*

# --- folders we DO want tracked (un-ignore from /*/ above) ---
!/further_experiments/
!/recap_2026/
!/scripts/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- virtualenvs / uv ---
.venv/
venv/
env/
.uv-cache/

# --- build / packaging artifacts ---
build/
dist/
wheels/
*.egg
*.egg-info/
pip-log.txt
pip-delete-this-directory.txt

# --- testing / type-checking caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- editors / IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- ML / experiment outputs ---
wandb/
mlruns/
*.tfevents.*
events.out.tfevents.*
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors

# Per-experiment output dirs (large image dumps, never push these)
outputs/
further_experiments/*/outputs/
recap_2026/output/
recap_2026/runs/

# --- jupyter ---
.ipynb_checkpoints/
